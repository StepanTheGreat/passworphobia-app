{
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420"
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "productName": "Passworphobia",
  "mainBinaryName": "Passworphobia",
  "version": "1.3.0",
  "identifier": "com.passworphobia.app",
  "plugins": {},
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "fullscreen": false,
        "resizable": true,
        "title": "Passworphobia",
        "width": 768,
        "height": 640,
        "minWidth": 768,
        "minHeight": 640,
        "useHttpsScheme": true
      }
    ],
    "security": {
      "csp": null
    }
  }
}